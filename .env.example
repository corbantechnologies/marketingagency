# LJK Marketing Agency frontend: environment variables.
# Copy to .env.local for local development. Never commit real values.

NEXTAUTH_SECRET=                      # Required. Long random string (openssl rand -base64 32)
AUTH_SECRET=                          # Optional alias of NEXTAUTH_SECRET
NEXTAUTH_URL=https://app.example.com  # Public URL of this app
ACCESS_TOKEN_TTL_MINUTES=55           # Keep below the API's JWT_ACCESS_MINUTES

BACKEND_URL=https://api.example.com          # API base URL used on the server
NEXT_PUBLIC_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://app.example.com

# Meta Embedded Signup (WhatsApp Tech Provider)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v23.0          # Same Graph API version as the backend WHATSAPP_API_VERSION

# Contact form email (Resend)
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com
RESEND_ADMIN_EMAIL=hello@example.com
ADMIN_EMAIL=hello@example.com
